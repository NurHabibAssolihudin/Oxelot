#!/usr/bin/env bash
# Zig C-compiler wrapper for cargo. Translates Rust target triples to names
# zig 0.16 accepts, then invokes `zig cc` with the given args.
#
# Zig is located via the ZIG env var (default: `zig` on PATH).
#   wasm32-unknown-unknown -> wasm32-freestanding
#   wasm32-wasip1          -> wasm32-wasi
set -euo pipefail

ZIG_BIN="${ZIG:-zig}"
args=()
for a in "$@"; do
  case "$a" in
    --target=wasm32-unknown-unknown) args+=("--target=wasm32-freestanding") ;;
    --target=wasm32-wasip1)          args+=("--target=wasm32-wasi") ;;
    *)                               args+=("$a") ;;
  esac
done
exec "$ZIG_BIN" cc "${args[@]}"
