{
  "name": "@oxelot/react",
  "version": "0.2.0",
  "description": "Open-Source Low-Level PWA Native-Bridge Library — React bindings",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "dependencies": {
    "@oxelot/core": "*"
  },
  "devDependencies": {
    "@types/react": "^18.3.4",
    "react": "^18.3.1",
    "tsup": "^8.2.4",
    "typescript": "^5.5.4"
  }
}
