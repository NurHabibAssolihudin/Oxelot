{
  "name": "Oxelot Dev",
  "build": {
    "dockerfile": "../docker/Dockerfile",
    "context": ".."
  },
  "workspaceFolder": "/app",
  "workspaceMount": "source=${localWorkspaceFolder},target=/app,type=bind,consistency=cached",
  "mounts": [
    "source=oxelot_node_modules,target=/app/node_modules,type=volume",
    "source=oxelot_wasm_target,target=/app/wasm/target,type=volume",
    "source=oxelot_playwright,target=/ms-playwright-browsers,type=volume"
  ],
  "forwardPorts": [5199],
  "portsAttributes": {
    "5199": { "label": "playground (vite)" }
  },
  "remoteEnv": {
    "PLAYWRIGHT_BROWSERS_PATH": "/ms-playwright-browsers"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "rust-lang.rust-analyzer",
        "ms-playwright.playwright",
        "tamasfe.even-better-toml"
      ],
      "settings": {
        "rust-analyzer.linkedProjects": ["wasm/Cargo.toml"],
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode"
      }
    }
  }
}
